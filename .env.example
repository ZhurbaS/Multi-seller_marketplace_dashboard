# Шаблон .env для dashboard (адмінка й кабінет продавця). Скопіюйте у ".env"
# (без ".example"). Файл читається ЛИШЕ при старті Vite — після змін
# перезапустіть "npm run dev". Покрокова інструкція: SETUP.md

VITE_MODE=dev

# Адреса back-сервера (порт 5000), БЕЗ "/" в кінці.
# Локально: http://localhost:5000
# У Codespaces: адреса виду https://xxxx-5000.app.github.dev (вкладка PORTS у Codespace бека)
VITE_LOCAL=http://localhost:5000

# Лише для production-збірки (VITE_MODE=pro)
VITE_PRODUCTION=

# Адреса сайту (front, порт 5173) — використовується для кнопки "Переглянути на сайті"
# (око в списку товарів) та посилань на сайт. Локально: http://localhost:5173
VITE_PRODUCTION_FRONT=http://localhost:5173
